# GEMINI_API_KEY: Optional - for Gemini AI legal RAG & Google search grounding.
# AI Studio / Netrun automatically injects this from secrets if configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g., https://any-pdf.de1.netrun.io/).
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: GitHub Fine-Grained or Classic Personal Access Token with 'repo' scope.
# Used by backend to sync accepted PDFs and Git LFS objects with the private GitHub repository.
GITHUB_TOKEN="ghp_your_github_token_here"

# GITHUB_OWNER & GITHUB_REPO: Target repository coordinates.
GITHUB_OWNER="barshapbp2026"
GITHUB_REPO="any-pdf-"
GITHUB_BRANCH="feature/full-nepali-pdf-search"

# ADMIN_PASSWORD: Plaintext password or leave blank to use the secure hashed configuration.
# Used for Admin Review, Accept/Reject, and Git LFS Push authorization.
ADMIN_PASSWORD="nepal@admin2082"

# ENABLE_GIT_LFS: Set to true to enable automated Git LFS tracking & pointer creation for files > 50MB.
ENABLE_GIT_LFS="true"
